{
  'extends': [
    'github>camptocamp/gs-renovate-config-preset:base.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:group.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:ci.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:preset.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:pre-commit.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:docker.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:json-schema.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:shellcheck.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:python.json5#1.0.1',
    'github>camptocamp/gs-renovate-config-preset:stabilization-branches.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:own.json5#0.8.5',
    'github>camptocamp/gs-renovate-config-preset:security.json5#1.0.1',
  ],
  baseBranches: [
    'prod-2-7',
    'prod-2-7-advance',
    'prod-2-8',
    'prod-2-8-advance',
    'prod-2-9',
    'prod-2-9-advance',
  ],
  /** Packages published very recently are not pushed to stabilization branches for security reasons */
  minimumReleaseAge: '7 days',
  ignorePaths: ['CONST_create_template/**', 'docker-compose-lib.yaml', 'ci/**'],
  html: {
    fileMatch: ['\\.html?$', '\\.html?.mako$'],
  },
  customManagers: [
    /** Manage jsdelivr */
    {
      matchStrings: ['cdn\\.jsdelivr\\.net/npm/(?<depName>[^@]+)@(?<currentValue>[^/]+)'],
      datasourceTemplate: 'npm',
      customType: 'regex',
      managerFilePatterns: ['/.*\\.html$/'],
    },
  ],
  packageRules: [
    /** Docker images versioning */
    {
      matchDatasources: ['docker'],
      versioning: 'loose',
    },
    {
      matchDatasources: ['docker'],
      versioning: 'regex:^(?<major>\\d+)(\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?)?-(?<compatibility>.*)$',
      matchDepNames: ['node'],
    },
    /** Parse Gdal Docker tag */
    {
      matchDatasources: ['docker'],
      versioning: 'regex:^(?<compatibility>.*)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)?$',
      matchDepNames: ['ghcr.io/osgeo/gdal'],
    },
    /** Parse Node Docker tag */
    {
      matchDatasources: ['docker'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>.*)$',
      matchDepNames: ['node'],
    },
    /** Accept only the patch on the stabilization branches */
    {
      matchBaseBranches: ['/^prod-^-7.*/', '/^prod-2-8.*/', '/^prod-2-9.*/'],
      matchUpdateTypes: ['major', 'minor', 'pin', 'digest', 'rollback', 'bump', 'lockFileMaintenance'],
      enabled: false,
    },
    {
      matchBaseBranches: ['/^prod-2-7.*/'],
      matchDatasources: ['docker-compose', 'github-actions'],
      enabled: false,
    },
    /** Disable upgrading the supported Python version */
    {
      matchFileNames: ['custom/pyproject.toml'],
      enabled: false,
      matchDepNames: ['python'],
    },
    {
      matchPackageNames: ['shellcheck-py/shellcheck-py'],
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$',
    },
    /** Packages published very recently are not pushed to stabilization branches for security reasons */
    {
      matchBaseBranches: ['/^prod-[0-9]+-[0-9]+(-advance)?$/'],
      minimumReleaseAge: '7 days',
    },
    /** Ungroup Gdal dependencies */
    {
      matchDepNames: ['ghcr.io/osgeo/gdal'],
      groupName: 'Gdal',
    },
    /** Don't update major version of bootstrap on ui/*.html files */
    {
      matchFileNames: ['ui/*.html'],
      matchUpdateTypes: ['major'],
      matchDepNames: ['bootstrap'],
      enabled: false,
    },
    /** Don't update major version on package.json */
    {
      matchFileNames: ['package.json'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    /** Make ngeo as loose, daily updates */
    {
      matchDepNames: ['ngeo'],
      groupName: 'Ngeo',
      versioning: 'loose',
      schedule: 'after 5am',
      minimumReleaseAge: '0',
    },
  ],
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
}
